# ==============================================================================
# Autonomous 30-Day Project Builder Agent - Environment Variables
# ==============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit your .env file to Git!

# --- Model Provider Configuration ---
# Choose one of: gemini | openai | anthropic | mock
LLM_PROVIDER=gemini

# Primary API keys (configure the one matching your LLM_PROVIDER):
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional model override (defaults depend on provider):
# LLM_MODEL=gemini-2.5-flash
# LLM_MODEL=gpt-4o-mini
# LLM_MODEL=claude-3-5-sonnet-20241022

# Optional custom base URL for OpenAI-compatible endpoints (e.g. DeepSeek, Groq, Ollama):
# OPENAI_BASE_URL=https://api.deepseek.com/v1

# --- GitHub Automation Credentials ---
# Personal Access Token with repo scope (contents:write, workflows:write if updating GHA)
# In GitHub Actions, GITHUB_TOKEN is automatically provided via secrets.GITHUB_TOKEN
GITHUB_TOKEN=
GITHUB_ACTOR=
GITHUB_EMAIL=

# --- Notifications (Optional) ---
# Discord or Slack Webhook URL for daily execution updates and failure alerts:
NOTIFICATION_WEBHOOK=

# SMTP Email alerts (Optional):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TO_EMAIL=
